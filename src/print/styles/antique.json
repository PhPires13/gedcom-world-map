    "maxWidth": 2.6,
    "taper": true,
    "arrow": "barb",
    "arrowSize": 3.2,
    "opacity": 0.92,
    "halo": "#f3e8c8",
    "haloWidth": 1.1,
    "dateSize": 3
  },
  "marks": {
    "kind": "town",
    "size": 1.8,
    "fill": "#f3e8c8",
    "stroke": "#3b2a1a"
  },
  "labels": {
    "placeSize": 3.4,
    "placeColor": "#3b2a1a",
    "countrySize": 6,
    "countryColor": "#6a5236",
    "countryLetterSpacing": 2.2,
    "oceanSize": 9,
    "oceanColor": "#6a5a44",
    "oceanLetterSpacing": 3.5,
    "halo": "rgba(240,226,189,0.75)"
  },
  "flags": {
    "radius": 6.5,
    "ring": "#3b2a1a",
    "ringWidth": 0.5,
    "outerRing": "#a8863a",
    "tone": 0.35,
    "labelSize": 3,
    "leader": "#5c4630"
  },
  "cartouche": {
    "kind": "scroll",
    "fill": "#f3e7c6",
    "stroke": "#3b2a1a",
