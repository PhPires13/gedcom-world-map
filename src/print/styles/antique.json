    "waterLines": {
      "count": 5,
      "spacing": 0.9,
      "width": 0.16,
      "color": "#5c4630",
      "opacity": 0.5
    },
    "landShade": {
      "color": "#b89b62",
      "width": 2.6,
      "opacity": 0.4
    },
    "borders": {
      "color": "#7a6244",
      "width": 0.28,
      "dash": [
        1.2,
        0.8
      ]
    },
    "graticule": {
      "step": 10,
      "color": "#9a8462",
      "width": 0.15,
      "dash": []
    },
    "rhumbLines": {
      "count": 0,
      "colors": [
        "#7a6244"
      ],
      "width": 0.15,
      "opacity": 0.3
    },
    "projection": "auto"
  },
  "routes": {
