{
  "id": "antique",
  "name": "Antique parchment",
  "description": "Aged paper, engraved coastlines and inked routes, in the manner of an 18th-century atlas.",
  "fonts": {
    "title": {
      "family": "IM Fell English SC",
      "weight": 400,
      "style": "normal",
      "widthFactor": 0.66
    },
    "heading": {
      "family": "IM Fell English SC",
      "weight": 400,
      "style": "normal",
      "widthFactor": 0.66
    },
    "body": {
      "family": "IM Fell English",
      "weight": 400,
      "style": "normal",
      "widthFactor": 0.47
    },
    "italic": {
      "family": "IM Fell English",
      "weight": 400,
      "style": "italic",
      "widthFactor": 0.43
    }
  },
  "uppercaseTitles": false,
  "paper": {
    "color": "#ead8ad",
    "grain": 0.32,
    "grainFrequency": 2.2,
    "stains": 0.35,
    "vignette": 0.6,
    "ageColor": "#6b4a1f"
  },
  "ink": {
