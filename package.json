{
  "name": "gedcom-world-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node server/dev-all.mjs",
    "server": "tsx server/main.ts",
    "server:dev": "tsx watch server/main.ts",
    "build": "tsc --noEmit && tsc --noEmit -p server && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
